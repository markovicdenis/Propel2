{
    "name": "propel/propel",
    "type": "library",
    "description": "Propel2 is an open-source Object-Relational Mapping (ORM) for PHP.",
    "keywords": [
        "ORM",
        "persistence",
        "Active Record"
    ],
    "homepage": "http://www.propelorm.org/",
    "license": "MIT",
    "authors": [
        {
            "name": "William Durand",
            "email": "william.durand1@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "psr/log": "^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/finder": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "symfony/uid": "^6.4 || ^7.0 || ^8.0",
        "symfony/validator": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-xml": "*",
        "monolog/monolog": "^3.10",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5",
        "spryker/code-sniffer": "^0.17",
        "psalm/phar": "^6.16",
        "mikey179/vfsstream": "^1.6",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "suggest": {
        "monolog/monolog": "The recommended PSR-3 logging library to use with Propel."
    },
    "autoload": {
        "psr-4": {
            "Propel\\": "src/Propel/"
        }
    },
    "bin": [
        "bin/propel"
    ],
    "scripts": {
        "testsuite": "composer run test && composer run cs-check && composer run stan && composer run psalm",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "fix": "php-cs-fixer fix --allow-risky=yes src",
        "stan": "vendor/bin/phpstan analyze",
        "stan-baseline": "vendor/bin/phpstan analyze --generate-baseline",
        "psalm": "vendor/bin/psalm.phar --config=psalm.xml",
        "psalm-update-baseline": "vendor/bin/psalm.phar --update-baseline",
        "psalm-set-baseline": "vendor/bin/psalm.phar --set-baseline=psalm-baseline.xml",
        "psalm-update-report": "vendor/bin/psalm.phar --report=psalm-report.xml",
        "test": [
            "@test:agnostic",
            "@test:sqlite"
        ],
        "test:agnostic": "phpunit --colors=always -c tests/agnostic.phpunit.xml",
        "test:mysql": "phpunit --colors=always -c tests/mysql.phpunit.xml",
        "test:sqlite": "phpunit --colors=always -c tests/sqlite.phpunit.xml",
        "test:pgsql": "phpunit --colors=always -c tests/pgsql.phpunit.xml"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev",
            "dev-dev": "2.1-dev",
            "dev-upgrade": "2.2-dev",
            "dev-builder": "2.3-dev",
            "dev-collections": "2.4-dev",
            "dev-uuid": "2.5-dev",
            "dev-partitioning": "2.6-dev",
            "dev-projection": "2.7-dev"
        }
    },
    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}